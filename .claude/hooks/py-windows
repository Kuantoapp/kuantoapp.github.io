#!/bin/sh
# Versión Windows de .claude/hooks/py. La lanza `py` cuando detecta Git Bash, MSYS o Cygwin: en Windows,
# Claude Code ejecuta los comandos de los hooks con el bash de Git for Windows.
# Diferencias con la versión de macOS y Linux:
#   - el Python del venv está en .venv/Scripts/python.exe;
#   - `python3` y `python` pueden ser el alias de la Microsoft Store, que no ejecuta nada: se prueban antes;
#   - existe el lanzador `py -3`;
#   - fuerza UTF-8 (PYTHONUTF8): con la página de códigos de Windows, los acentos y «» rompen la salida;
#   - si existe <script>_windows.py junto al script, se ejecuta ese (versión Windows del hook);
#   - las rutas de Windows llegan con «\» (data\raw): el bloqueo de --critico las reconoce.
# Uso: el mismo que `py`: sh .claude/hooks/py-windows [--critico] script.py [args…]

critico=0
[ "$1" = "--critico" ] && { critico=1; shift; }
raiz="${CLAUDE_PROJECT_DIR:-.}"
command -v cygpath >/dev/null 2>&1 && raiz=$(cygpath -u "$raiz")
entrada=$(cat)
arreglo="ejecuta 'uv venv && uv pip install -r requirements-dev.txt' en la raíz del repo (instala uv si no lo tienes: https://docs.astral.sh/uv/)"

toca_raw() { printf '%s' "$entrada" | grep -qE 'data(/|\\)+raw'; }
funciona() { "$@" -c "import sys" >/dev/null 2>&1; }

if [ $# -gt 0 ]; then
  alternativo="${1%.py}_windows.py"
  [ -f "$alternativo" ] && { shift; set -- "$alternativo" "$@"; }
fi

export PYTHONUTF8=1 PYTHONIOENCODING=utf-8

if [ -x "$raiz/.venv/Scripts/python.exe" ]; then
  set -- "$raiz/.venv/Scripts/python.exe" "$@"
elif [ -x "$raiz/.venv/bin/python" ]; then
  set -- "$raiz/.venv/bin/python" "$@"
elif command -v uv >/dev/null 2>&1; then
  version=$(cat "$raiz/.python-version" 2>/dev/null || echo 3)
  set -- uv run --quiet --no-project --python "$version" python "$@"
elif command -v py >/dev/null 2>&1 && funciona py -3; then
  set -- py -3 "$@"
elif command -v python >/dev/null 2>&1 && funciona python; then
  set -- python "$@"
elif command -v python3 >/dev/null 2>&1 && funciona python3; then
  set -- python3 "$@"
else
  if [ "$critico" = 1 ] && toca_raw; then
    echo "Bloqueado: no hay Python para el hook que protege data/raw; $arreglo." >&2
    exit 2
  fi
  echo "Hooks del proyecto sin Python: $arreglo." >&2
  exit 1
fi

printf '%s' "$entrada" | "$@"
estado=$?
# 0 = sigue, 2 = el script bloquea a propósito; otro código = el intérprete o el script fallaron
if [ "$estado" -ne 0 ] && [ "$estado" -ne 2 ] && [ "$critico" = 1 ] && toca_raw; then
  echo "Bloqueado: el hook que protege data/raw no pudo ejecutarse (código $estado); $arreglo." >&2
  exit 2
fi
exit "$estado"
