 "@id": "https://yeraybc.github.io/DataMad-hackaton-2026/datos/#dataset",
 "@type": "dcat:Dataset",
 "dct:title": "Datos abiertos de Kuanto: API estática de euros, tiempos y análisis",
 "dct:description": "Ficheros JSON y GeoJSON que publica la herramienta Kuanto (DataMad 2026) para la Comunidad de Madrid: neto desde el bruto, tarifas del transporte público, tiempos de viaje, alquiler por zona, perfiles de hogar, análisis del esfuerzo del alquiler y del Bono Alquiler Joven, y los indicadores en Smart Data Models. Son datos derivados de fuentes oficiales y de OpenStreetMap, con la licencia y la cita de cada fichero. Lo estimado está marcado en las notas de cada fichero.",
 "dct:publisher": {"@id": "https://yeraybc.github.io/DataMad-hackaton-2026/#publicador", "@type": "foaf:Agent", "foaf:name": "Equipo Kuanto (DataMad 2026)"},
